# inference.club frontend — environment reference (Nuxt runtimeConfig).
# Copy to frontend/.env for local dev, or set in the k8s Deployment / compose.

# Public API base the BROWSER calls. [all]
#   local compose: http://localhost:8101   home lab: https://club.lan   cloud: https://api.inference.club
NUXT_PUBLIC_API_BASE=https://club.lan

# API base used during SSR (inside the container, where the public host isn't
# reachable). Point at the backend Service DNS. Empty falls back to the public base. [all]
NUXT_API_BASE_INTERNAL=http://backend:8001

# Google Analytics measurement id (public token). [cloud]
NUXT_PUBLIC_GTAG_ID=

# Dev-only: point Vite's HMR client at the published host port (compose maps 3100:3000). [local]
NUXT_VITE_HMR_CLIENT_PORT=
# Dev-only: separate build dir for host-side `yarn dev` so it doesn't clash with the container's .nuxt. [local]
NUXT_LOCAL_BUILD_DIR=
