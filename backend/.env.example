# inference.club backend — environment reference.
#
# Canonical list of the env vars the backend reads (backend/backend/settings.py).
# Copy to backend/.env for local dev, or use it to build the k8s ConfigMap/Secret
# (home lab) and the Pulumi-rendered backend.env (cloud). Every value here is a
# DEFAULT or example — nothing secret. Tags mark where each var matters:
#   [all] [local] [homelab] [cloud]
# Secrets ([secret]) must come from a k8s Secret / Pulumi secret, never git.

# ---- core ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me                       # [all][secret] real key in prod/homelab
DJANGO_DEBUG=False                                # [all] True only for local dev
DJANGO_ALLOWED_HOSTS=club.lan,localhost           # [all] comma-separated; "*" in dev
DATABASE_URL=postgres://user:pass@host:5432/db    # [all][secret] home lab: platform postgres
REDIS_URL=redis://redis:6379/0                    # [all] cache + celery broker/results derive from this

# ---- deploy / runtime metadata ------------------------------------------
DEPLOY_ENV=homelab                                # [all] local | homelab | cloud (shown in /api/meta)
APP_VERSION=dev                                   # [all] git tag / image tag (set by CI)
GIT_SHA=                                          # [all] built commit (set by CI)
PORT=8001                                         # [all] gunicorn bind port
GUNICORN_WORKERS=2                                # [all]
GUNICORN_THREADS=8                                # [all]
GUNICORN_TIMEOUT=600                              # [all] long streaming proxies need a high timeout
RUN_MIGRATIONS_ON_START=1                         # [all] 1 = migrate on boot (compose/VPS); 0 in k8s (use a Job)

# ---- CORS / CSRF / cookies ----------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=https://club.lan      # [all] frontend origin(s), comma-separated
DJANGO_CSRF_TRUSTED_ORIGINS=https://club.lan      # [all]
DJANGO_CSRF_COOKIE_DOMAIN=                         # [cloud] set when frontend+api are subdomains of one parent
DJANGO_SESSION_COOKIE_DOMAIN=                      # [cloud] same

# ---- auth: which sign-in methods this deployment offers -----------------
AUTH_GITHUB_ENABLED=                              # [all] default: on when GitHub creds present. cloud=on, homelab=off
AUTH_EMAIL_ENABLED=                              # [all] default off. homelab=on (needs SMTP below), cloud=off
GITHUB_OAUTH_CLIENT_ID=                           # [cloud][secret]
GITHUB_OAUTH_CLIENT_SECRET=                       # [cloud][secret]
SOCIAL_AUTH_LOGIN_REDIRECT_URL=https://club.lan/  # [cloud] where the browser lands after OAuth
SOCIAL_AUTH_LOGIN_ERROR_URL=https://club.lan/login?oauth_error=1  # [cloud]

# ---- email (confirmation links for the email sign-up flow) --------------
# Only used when AUTH_EMAIL_ENABLED. Default backend is console (prints to log).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend  # [homelab] console backend for local
EMAIL_HOST=mailpit.platform.svc.cluster.local     # [homelab] in-cluster Mailpit
EMAIL_PORT=1025                                    # [homelab]
EMAIL_HOST_USER=                                   # [homelab][secret] blank for Mailpit
EMAIL_HOST_PASSWORD=                               # [homelab][secret] blank for Mailpit
EMAIL_USE_TLS=False                                # [homelab]
DEFAULT_FROM_EMAIL=inference.club <no-reply@inference.club>  # [homelab]
FRONTEND_BASE_URL=https://club.lan                 # [homelab] origin the confirmation link points at
EMAIL_CONFIRMATION_TTL_HOURS=48                    # [homelab]

# ---- object storage: media (generated images/audio/video/3D, STT input) --
# Precedence: GCS_* (cloud) > OBJECT_STORAGE_* (S3/MinIO) > local filesystem.
# Home lab uses the in-cluster MinIO (platform/minio); cloud uses GCS.
OBJECT_STORAGE_BUCKET=inference-club-media         # [homelab]
OBJECT_STORAGE_ENDPOINT=http://minio.platform.svc.cluster.local:9000  # [homelab]
OBJECT_STORAGE_ACCESS_KEY=                          # [homelab][secret]
OBJECT_STORAGE_SECRET_KEY=                          # [homelab][secret]
OBJECT_STORAGE_REGION=us-east-1                     # [homelab]
GCS_PUBLIC_BUCKET=                                  # [cloud]
GCS_PRIVATE_BUCKET=                                 # [cloud]
GCS_CREDENTIALS_B64=                                # [cloud][secret] base64 service-account JSON

# ---- async jobs (Celery) ------------------------------------------------
ASYNC_ENABLED=                                     # [all] default: on when a broker (REDIS_URL) exists
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL on separate DBs.

# ---- playground agent tools ---------------------------------------------
AGENT_ENABLED=True                                 # [all]
AGENT_SEARXNG_URL=                                 # [homelab] in-cluster SearXNG JSON API (web_search)
AGENT_BROWSERLESS_URL=                             # [homelab] headless-Chrome REST base (browse tool)
AGENT_BRAVE_API_KEY=                               # [all][secret] optional instance-wide Brave key

# ---- tailscale (reaching agents over the inference.club tailnet) --------
# Cloud only. Home lab runs the agent in-cluster and reaches nodes over the LAN.
INFERENCE_DIRECT_AGENTS=False                       # [cloud] True in local/homelab (trust reported host)
TAILNET_PROXY_URL=                                  # [cloud] e.g. socks5h://tailscale:1055
TAILSCALE_TAILNET=                                  # [cloud]
TAILSCALE_OAUTH_CLIENT_ID=                          # [cloud][secret]
TAILSCALE_OAUTH_CLIENT_SECRET=                      # [cloud][secret]

# ---- tuning knobs (sensible defaults; override only if needed) ----------
# Rate limits: INFERENCE_RATE_LIMIT, MODELS_RATE_LIMIT, ANON_*_RATE_LIMIT,
#   EMAIL_AUTH_RATE_LIMIT. Guardrails: INFERENCE_MAX_*, IMAGE_MAX_*, STT_MAX_*,
#   TTS_MAX_*, MEDIA_MAX_UPLOAD_BYTES. Jobs: JOB_*_TIMEOUT_SECONDS,
#   WORKFLOW_MAX_FANOUT, RENDER_MAX_CONCURRENT. See settings.py for the full set.
